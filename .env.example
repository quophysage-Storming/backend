# Server Configuration
PORT=5000
NODE_ENV=development

# SeevPlus Native Payment Gateway
SEEVPLUS_MERCHANT_NAME=SeevPlus OnTime Arrival
SEEVPLUS_MERCHANT_ID=SEEVPLUS_GH_001
SEEVPLUS_API_KEY=seevplus_live_key_gh
SEEVPLUS_SECRET_KEY=seevplus_secret_token_secure

# Arkesel SMS API Configuration (v2)
ARKESEL_API_KEY=your_arkesel_api_key_here
ARKESEL_SENDER_ID=SeevPlus
ARKESEL_SMS_URL=https://sms.arkesel.com/api/v2/sms/send
ARKESEL_BALANCE_URL=https://sms.arkesel.com/api/v2/clients/balance-details

# OnTime Arrival Settings
QR_SECRET=seevplus_secure_qr_hash_secret_2026
DEFAULT_ARRIVAL_TIME=08:00
GRACE_PERIOD_MINUTES=10

# Database Storage
DB_FILE_PATH=./data/seevplus_db.json
